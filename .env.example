# =============================================================================
# .env.example — contrato de variables de entorno (twelve-factor, DD-11)
# =============================================================================
# Copia este archivo a `.env` para el stack LOCAL. NUNCA pongas secretos reales
# en `.env` ni los commitees.
#
# GESTION DE SECRETOS (DD-5 / `08` Gestion de secretos):
#   En PRODUCCION los valores marcados [SECRETO] se inyectan via HashiCorp Vault
#   en un tmpfs efimero en runtime — NUNCA se hornean en la imagen Docker ni se
#   versionan. Los valores de abajo son PLACEHOLDERS DE DESARROLLO LOCAL.
# =============================================================================

# --- App / runtime ---
ENVIRONMENT=local
APP_NAME=proctoring-api
API_V1_PREFIX=/api/v1

# --- Base de datos PostgreSQL/TimescaleDB --- [SECRETO en prod -> Vault/tmpfs]
DATABASE_URL=postgresql+asyncpg://proctoring:dev-only-change-me@postgres:5432/proctoring
POSTGRES_USER=proctoring
POSTGRES_PASSWORD=dev-only-change-me
POSTGRES_DB=proctoring

# --- Object storage MinIO/S3 ---
STORAGE_ENDPOINT=http://minio:9000
STORAGE_BUCKET_EVIDENCE=evidence
STORAGE_ACCESS_KEY=dev-minio-access            # [SECRETO en prod -> Vault/tmpfs]
STORAGE_SECRET_KEY=dev-minio-secret-change-me  # [SECRETO en prod -> Vault/tmpfs]
MINIO_ROOT_USER=dev-minio-access
MINIO_ROOT_PASSWORD=dev-minio-secret-change-me

# --- Identidad (JWT propio) — auth REAL es C-06; aqui solo corre el contenedor ---
JWT_AUDIENCE=proctoring-api

# --- Gestion de secretos (Vault) --- [SECRETO -> inyeccion de arranque]
VAULT_ADDR=
VAULT_TOKEN=

# --- Observabilidad (OpenTelemetry / DD-12) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
OTEL_SERVICE_NAME=proctoring-api

# --- Mensajeria (pieza decidida por la PoC C-03; default A4 = postgres) ---
# NO levantar redis/rabbitmq por defecto (DD-19). Cambiar SOLO si C-03 lo exige.
MESSAGING_BACKEND=postgres

# --- Auth provider propio (C-55)   proveedor JWT propio como alternativa a Keycloak ---
# AUTH_PROVIDER: 'jwt' = formulario login + JWT propio (default, MVP self-hosted)
AUTH_PROVIDER=jwt

# Secreto HS256 para firmar los JWT propios. [SECRETO en prod -> Vault/tmpfs]
# Minimo 32 chars aleatorios. Ejemplo: openssl rand -hex 32
JWT_OWN_SECRET=CHANGE_ME_use_openssl_rand_hex_32_at_least  # [SECRETO]
JWT_OWN_ISSUER=activeexam-auth
REFRESH_TOKEN_TTL_SECONDS=604800  # 7 dias (default)

# Contrase as de usuarios seed (SOLO entorno local / staging). [SECRETO]
# El script backend/scripts/seed_users.py las lee al correr.
SEED_ESTUDIANTE_PASSWORD=CHANGE_ME_min8chars
SEED_COORDINADOR_PASSWORD=CHANGE_ME_min8chars
SEED_ADMIN_PASSWORD=CHANGE_ME_min8chars

# Frontend: proveedor de auth activo (debe coincidir con AUTH_PROVIDER del backend)
# VITE_AUTH_PROVIDER=jwt   # (default en .env local)



# MinIO/WORM (c-77) — opcional. Sin estas 4 vars, la evidencia (screenshots de
# proctoring) queda SOLO en Postgres, exactamente como funciona hoy — el sistema
# arranca y anda igual sin ellas. Se activan recien cuando levantes la VPS con
# MinIO corriendo; ahi el sistema empieza a depositar ADEMAS en el bucket con
# Object Lock (evidencia inmutable). Dejar vacias para el deploy de hoy en Render.

# URL donde corre tu servidor MinIO, CON puerto, SIN el nombre del bucket al final.
# Ejemplo: http://IP_DE_TU_VPS:9000  o  https://minio.tudominio.com
MINIO_ENDPOINT=

# El "usuario" / access key con el que tu app se conecta a MinIO. Vos lo definis
# al levantar el contenedor de MinIO (variable MINIO_ROOT_USER), o creas uno
# aparte con permisos acotados via `mc admin user add`. NO es una clave que
# genere este proyecto — la elegis vos al instalar MinIO en la VPS.
MINIO_ACCESS_KEY=

# La "contraseña" / secret key de esa access key de arriba. Se define en el
# mismo momento (variable MINIO_ROOT_PASSWORD al levantar MinIO, o al crear el
# usuario con `mc admin user add`). Guardala en un lugar seguro (gestor de
# secretos / variables de entorno de Render) — nunca la escribas en texto plano
# en un archivo que se commitee al repo (por eso aca queda vacia).
MINIO_SECRET_KEY=

# Nombre del bucket (la "carpeta" contenedora) donde se van a depositar los
# screenshots de evidencia. Lo elegis vos al crear el bucket en MinIO; el
# entorno de desarrollo local usa "activeexam-evidencia" como convencion.
MINIO_BUCKET_EVIDENCIA=
