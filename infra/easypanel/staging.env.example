# =============================================================================
# ActiveExam STAGING (EasyPanel) — template de variables de entorno.
#
# Cargar estos valores en la pestaña "Environment" del servicio Compose de EasyPanel.
# NUNCA commitear los valores REALES. Este archivo es solo el template.
# =============================================================================

# --- Base de datos -----------------------------------------------------------
# Generar: openssl rand -base64 24   (si tiene @ : / URL-encodearla en DATABASE_URL)
POSTGRES_PASSWORD=REEMPLAZAR_password_postgres

# Variable ÚNICA. La password DEBE coincidir con POSTGRES_PASSWORD de arriba.
# host = postgres (nombre del servicio en la red interna del compose).
DATABASE_URL=postgresql+asyncpg://proctoring:REEMPLAZAR_password_postgres@postgres:5432/proctoring

# --- Secretos de la app ------------------------------------------------------
# JWT propio (HS256). Generar: openssl rand -base64 32
JWT_OWN_SECRET=REEMPLAZAR_jwt_secret

# Clave Fernet para cifrado at-rest de embeddings biométricos Y screenshots (Ley 25.326).
# Generar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# OJO: rotar esta clave deja ilegible el histórico cifrado (hay que re-cifrar).
EMBEDDING_ENCRYPTION_KEY=REEMPLAZAR_fernet_key

# --- Frontend (Vercel) → CORS ------------------------------------------------
# URL del frontend desplegado en Vercel. Sin esto, el browser da error de CORS.
FRONTEND_ORIGIN=https://TU-FRONT.vercel.app

# --- Seed de usuarios demo (idempotente) -------------------------------------
# Passwords de los usuarios sembrados (admin / estudiante1..4 / coordinador1).
SEED_ADMIN_PASSWORD=REEMPLAZAR_admin
SEED_ESTUDIANTE_PASSWORD=REEMPLAZAR_estudiante
SEED_COORDINADOR_PASSWORD=REEMPLAZAR_coordinador

# --- Runtime -----------------------------------------------------------------
PORT=8000
ENVIRONMENT=staging
