# Entorno y secretos — NUNCA versionar (DD-5)
.env
*.env.local

# Certificados / claves privadas TLS (local) — solo el README se versiona
infra/nginx/tls/*.key
infra/nginx/tls/*.crt
infra/nginx/tls/*.pem

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.venv312/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Node / frontend
node_modules/
dist/
.vite/

# MediaPipe models y WASM (~42 MB) — COMMITEADOS al repo para que Vercel los sirva
# como assets estáticos (self-hosted, sin CDN en runtime). Regenerables con
# scripts/download-mediapipe-models.sh si hiciera falta.

# Datos de contenedores
postgres_data/
minio_data/

# Estado de herramientas de scaffolding local — no es parte del proyecto
*-state.json
.claude/

# Overrides locales de docker-compose (específicos de cada máquina, p. ej. cambiar
# FRONTEND_ORIGIN cuando el 5173 está ocupado). NO versionar.
infra/docker-compose/docker-compose.dev.local.yml

# Playwright MCP screenshots / dumps de review
.playwright-mcp/
# Screenshots sueltos en la root (Playwright MCP los guarda con nombre explícito
# fuera de .playwright-mcp/). Solo root, para no pisar assets en public/ o src/.
/*.png
*.stackdump

# Engram: dump cross-project del capturador (NO versionar — filtra data de otros
# proyectos en un repo público). Los chunks/ y manifest.json sí se versionan.
.engram/all_projects.json

# Test venv efímero (C-70)
backend/.venv-test/

# Documentación de trabajo (guías de Moodle, PDFs/DOCX de discovery, capturas).
# Decisión del owner: NADA de docs/ se versiona — son material de consulta local,
# pesado y a menudo con datos del campus.
docs/

# Throwaways locales de la sesión de demo (no versionar)
tmp/
import_cloze.py
